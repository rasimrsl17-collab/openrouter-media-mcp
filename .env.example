# ---- REQUIRED ----
OPENROUTER_API_KEY=sk-or-v1-...
# Long random string. Same value goes into LibreChat's .env as OPENROUTER_MEDIA_SECRET.
# Generate: openssl rand -hex 32
MCP_SHARED_SECRET=change-me
# Public HTTPS address where this server's /media/* is reachable (see nginx.example.conf)
PUBLIC_BASE_URL=https://velorafy.com/mcp-media

# ---- CREDIT CHECK (LiteLLM customer budgets) ----
# Media calls go straight to OpenRouter, so this server checks the user's credit itself:
#   remaining = max_budget - spend (LiteLLM /customer/info, id = X-User-ID) - media already charged here
# Create a LiteLLM key that may ONLY call /customer/info (see README), never use the master key.
LITELLM_URL=http://10.116.0.7:4000
LITELLM_CUSTOMER_KEY=sk-...
# charged = OpenRouter cost x COST_MARKUP
COST_MARKUP=1
# Estimates used to refuse a call up front (real image/video cost is read from OpenRouter afterwards;
# speech has no reported cost, so its estimate is also the charge). Check openrouter.ai pricing.
ESTIMATE_IMAGE_USD=0.08
ESTIMATE_VIDEO_USD_PER_SECOND=0.08
ESTIMATE_TTS_USD_PER_1K_CHARS=0.03
# Shown to users who run out of credit (optional)
TOPUP_URL=https://velorafy.com

# ---- MODELS (admin-fixed; first one is the default) ----
# Full lists: https://openrouter.ai/api/v1/images/models , /videos/models , /models?output_modalities=speech
ALLOWED_IMAGE_MODELS=google/gemini-3.1-flash-image,bytedance-seed/seedream-5-0-flash
ALLOWED_VIDEO_MODELS=google/veo-3.1-lite,bytedance/seedance-2.0-fast
ALLOWED_TTS_MODELS=microsoft/mai-voice-2.1
DEFAULT_TTS_VOICE=en-US-Harper:MAI-Voice-2.1

# ---- PER-USER DAILY LIMITS (0 = tool disabled) ----
LIMIT_IMAGES_PER_DAY=20
LIMIT_VIDEOS_PER_DAY=2
LIMIT_TTS_PER_DAY=30

# ---- COST CAPS ----
MAX_IMAGES_PER_CALL=2
MAX_VIDEO_SECONDS=8
# tried in this order when the user does not ask for a resolution
ALLOWED_VIDEO_RESOLUTIONS=480p,720p
MAX_TTS_CHARS=3000

# ---- OTHER ----
PORT=3400
MEDIA_TTL_DAYS=30
# keep below the `timeout` set for this server in librechat.yaml (300000 ms = 300 s)
VIDEO_MAX_WAIT_SECONDS=240
VIDEO_POLL_SECONDS=6

# ---- CREATOR STUDIO: assemble_short (ffmpeg, no AI cost) ----
LIMIT_SHORTS_PER_DAY=5
MAX_SHORT_SECONDS=90
# 1 on a 1-2 vCPU droplet; raise only with more CPU
MAX_CONCURRENT_RENDERS=1

# ---- CREATOR STUDIO: publishing via Zernio (leave ZERNIO_API_KEY empty to disable) ----
# API key from zernio.com (starts with sk_). One Zernio profile is created per LibreChat user.
ZERNIO_API_KEY=
# Page users return to after connecting an account (e.g. your LibreChat address)
SOCIAL_REDIRECT_URL=https://velorafy.com/c/new
# Zernio platform ids users may connect (check the ids in Zernio's docs before adding more)
SOCIAL_PLATFORMS=youtube,tiktok,instagram,facebook,linkedin,pinterest,threads
LIMIT_POSTS_PER_DAY=10
# Your Zernio cost passed to the user: charged per account per published post (x COST_MARKUP). 0 = free
SOCIAL_POST_FEE_USD=0.05
